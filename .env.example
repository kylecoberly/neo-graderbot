ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=neo-graderbot
# Only loopback names may reach the queue; list any other host name you serve it on
# (comma-separated) to allow it.
GRADERBOT_ALLOWED_HOSTS=
# Signs the demo's pages and receipts. Any long random string (openssl rand -hex 32);
# required in production, invented per process in development.
GRADERBOT_PAGE_SECRET=
# The demo's three models: the grading agent (default anthropic:claude-sonnet-5, the model
# the evals say to ship), the question generator (Sonnet 5) and the page judge (Opus 5).
DEMO_AGENT_MODEL=
DEMO_GENERATOR_MODEL=
DEMO_JUDGE_MODEL=
# 1 = no model calls at all: deterministic fakes, for UI work and `pnpm e2e`.
GRADERBOT_FAKE_MODEL=
# 1 = no live model calls on the hosted demo: pages show the grades stored in
# data/demo-fallback.json, and the judge and "Try your own" are off. Read at
# build time, so changing it takes a redeploy.
NEXT_PUBLIC_GRADERBOT_RECORDED=
